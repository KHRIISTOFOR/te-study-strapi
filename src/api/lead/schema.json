{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "Заявка",
    "description": "Заявки с сайта"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "formType": {
      "type": "enumeration",
      "enum": ["application", "contact"],
      "required": true
    },
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "lastname": {
      "type": "string",
      "maxLength": 255
    },
    "fatherName": {
      "type": "string",
      "maxLength": 255
    },
    "motherName": {
      "type": "string",
      "maxLength": 255
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 50
    },
    "email": {
      "type": "email",
      "maxLength": 255
    },
    "university": {
      "type": "string",
      "maxLength": 255
    },
    "country": {
      "type": "string",
      "maxLength": 255
    },
    "message": {
      "type": "text"
    },
    "amocrmLeadId": {
      "type": "string",
      "maxLength": 50
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "contacted", "qualified", "converted", "closed"],
      "default": "new"
    },
    "notes": {
      "type": "text"
    },
    "ipAddress": {
      "type": "string",
      "maxLength": 45
    },
    "userAgent": {
      "type": "text"
    }
  }
}
