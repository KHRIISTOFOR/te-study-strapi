{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Услуга",
    "description": "Услуги TE.STUDY"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "shortDescription": {
      "type": "string",
      "maxLength": 500
    },
    "icon": {
      "type": "string",
      "default": "ri-graduation-cap-line"
    },
    "price": {
      "type": "string",
      "default": "Бесплатно"
    },
    "duration": {
      "type": "string",
      "default": "1-2 недели"
    },
    "features": {
      "type": "json"
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
